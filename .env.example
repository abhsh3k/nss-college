HOST=127.0.0.1
PORT=3000
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=3001
UPLOAD_DIR=uploads
SITE_URL=http://127.0.0.1:3000
RUST_LOG=nss_college=debug,tower_http=info
DATABASE_URL=postgres://nss:nss@localhost:5432/nss_college
# Set to true when the site is served over HTTPS (always in production). This
# also enables the HSTS header; never send HSTS from a plain-HTTP dev server.
COOKIE_SECURE=false

# Automated backups (see README, "Backups and housekeeping").
# BACKUP_ENABLED=true
# BACKUP_DIR=backups
# BACKUP_KEEP=7
# BACKUP_INTERVAL_HOURS=24
# On a deployment with no pg_dump on PATH, take the dump through Compose:
# BACKUP_DOCKER_SERVICE=db

# Seed the demo accounts on start-up. Credentials go to this file (0600) and
# never to the log; unset both once the accounts exist.
# SEED_DEMO_USERS=true
# SEED_CREDENTIALS_FILE=/run/secrets/demo-credentials.txt
