/target
.env
/uploads/*
!/uploads/.gitkeep

# tailwind.css is a build artifact, but it is committed on purpose: the deploy
# image has no Node/Tailwind to run build-css.sh, so without it the deployed
# site renders unstyled. Re-run build-css.sh after changing templates.

/tailwindcss.exe
/tailwindcss

# Plaintext test credentials - never commit
/usename.txt
/username.txt
/credentials*.txt

# Runtime logs from local dev runs - never commit
/server.log
/server.err
